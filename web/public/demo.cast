[30.771408, "o", "\u001b[?25l\u001b(B\u001b[m\u001b[33B\u001b[J\u001b[93mdefaults.lua: Did not detect DSR response from terminal. This results in a slower startup time.\u001b[H\u001b(B\u001b[0;1m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27mpackage\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m main\u001b[K\r\n\u001b[K\n\u001b(B\u001b[0;1m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27mimport\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m (\u001b[K\r\n        \u001b(B\u001b[m\u001b[38;2;179;246;192m\u001b[48;2;20;22;27m\"fmt\"\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\u001b[K\r\n        \u001b(B\u001b[m\u001b[38;2;179;246;192m\u001b[48;2;20;22;27m\"net\"\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\u001b[K\r\n        \u001b(B\u001b[m\u001b[38;2;179;246;192m\u001b[48;2;20;22;27m\"os\"\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\u001b[K\r\n)\u001b[K\r\n\u001b[K\n\u001b(B\u001b[m\u001b[38;2;155;158;164m\u001b[48;2;20;22;27m// Ensures gofmt doesn't remove the \"net\" and \"os\" imports in stage 1 (feel free to remove this!)\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\u001b[K\r\n\u001b(B\u001b[0;1m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27mvar\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m _ = net.Listen\u001b[K\r\n\u001b(B\u001b[0;1m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27mvar\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m _ = os."]
[30.771581, "o", "Exit\u001b[K\r\n\u001b[K\n\u001b(B\u001b[0;1m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27mfunc\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m main() {\u001b[K\r\n        \u001b(B\u001b[m\u001b[38;2;155;158;164m\u001b[48;2;20;22;27m// You can use print statements as follows for debugging, they'll be visible when running tests.\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\u001b[K\r\n        fmt.Println(\u001b(B\u001b[m\u001b[38;2;179;246;192m\u001b[48;2;20;22;27m\"Logs from your program will appear here!\"\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m)\u001b[K\r\n\u001b[K\n        l, err := net.Listen(\u001b(B\u001b[m\u001b[38;2;179;246;192m\u001b[48;2;20;22;27m\"tcp\"\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m, \u001b(B\u001b[m\u001b[38;2;179;246;192m\u001b[48;2;20;22;27m\"0.0.0.0:6379\"\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m)\u001b[K\r\n        \u001b(B\u001b[0;1m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27mif\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m err != \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27mnil\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m {\u001b[K\r\n                fmt.Println(\u001b(B\u001b[m\u001b[38;2;179;246;192m\u001b[48;2;20;22;27m\"Failed to bind to port 6379\"\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m)\u001b[K\r\n   "]
